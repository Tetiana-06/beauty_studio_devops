# 1. Базовий образ веб-сервера із встановленим Nginx
FROM nginx:alpine

# 2. Копіювання файлів у Nginx
COPY index.html /usr/share/nginx/html/index.html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 3. Порт веб-сервера
# повідомляє, що Nginx всередині контейнера працює на стандартному веб-порті 80.
EXPOSE 80

# 4. Запуск у фоновому режимі контейнера
CMD ["nginx", "-g", "daemon off;"]

# Якщо Nginx запустити за замовчуванням як демон (daemon on), він створить свій фоновий робочий процес,
# а первинна команда поверне статус «успішно виконано» і завершить роботу.
# тому в Dockerfile для Nginx пишуть директиву daemon off;
# — це примушує Nginx залишатися на передньому плані (foreground), не ховаючись у фон. Контейнер бачить, що процес активний, і залишається в робочому стані.